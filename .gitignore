cache/*
!cache/.gitkeep
results/*
!results/.gitkeep
reportcards/*
!reportcards/.gitkeep

# Raw/licensed inputs, returned model outputs, and nested upstream repositories.
# Keep acquisition instructions and hashes in source control; acquire the bytes
# separately in each environment.
data/*
!data/.gitkeep

# Reproducible generated artifacts. Their builders, allowlists, and authored
# reports remain tracked.
bundles/
dashboard_data/
external_review_packet/
external_review_packets/
leaderboard/
site/
validation_reports/
kaggle_outputs/
imported/

# V5 release manifests are built from explicit allowlists under configs/release/.
# Never add blanket exceptions for raw data, caches, returned model outputs, or ZIPs.
