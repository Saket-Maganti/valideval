{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "is_correct": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Is Correct"
    },
    "item_id": {
      "title": "Item Id",
      "type": "string"
    },
    "logprob": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Logprob"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "prediction": {
      "title": "Prediction",
      "type": "string"
    },
    "prompt_variant": {
      "title": "Prompt Variant",
      "type": "string"
    },
    "raw_output": {
      "title": "Raw Output",
      "type": "string"
    },
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "score": {
      "title": "Score",
      "type": "number"
    }
  },
  "required": [
    "model_id",
    "item_id",
    "prompt_variant",
    "prediction",
    "score",
    "raw_output"
  ],
  "title": "ModelPrediction",
  "type": "object"
}