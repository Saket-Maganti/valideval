{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "item_ids": {
      "items": {
        "type": "string"
      },
      "title": "Item Ids",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "model_ids": {
      "items": {
        "type": "string"
      },
      "title": "Model Ids",
      "type": "array"
    },
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "values": {
      "items": {
        "items": {
          "type": "number"
        },
        "type": "array"
      },
      "title": "Values",
      "type": "array"
    }
  },
  "required": [
    "model_ids",
    "item_ids",
    "values"
  ],
  "title": "ResponseMatrix",
  "type": "object"
}